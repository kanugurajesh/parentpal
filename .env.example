# --- API ---
PORT=4000
DATABASE_URL=postgres://parentpal:parentpal@localhost:5433/parentpal
TEST_DATABASE_URL=postgres://parentpal:parentpal@localhost:5433/parentpal_test
JWT_SECRET=change-me-to-a-long-random-string
# Protects /v1/admin/* and /v1/dev/* (sent as x-admin-key header)
ADMIN_KEY=dev-admin-key

# --- LLM ---
# "groq", "openai" or "mock". Auto: groq if GROQ_API_KEY is set, else openai if OPENAI_API_KEY is set, else mock.
LLM_PROVIDER=
# Groq (https://console.groq.com/keys), called through the OpenAI SDK at https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenAI (or any other OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint
OPENAI_BASE_URL=
# USD per 1M tokens, used for cost logging. Defaults match Groq gpt-oss-120b; verify against current pricing.
LLM_PRICE_INPUT_PER_M=0.15
LLM_PRICE_OUTPUT_PER_M=0.60
# Optional: reasoning_effort sent with every call, and extra output tokens reserved for reasoning.
# Groq's gpt-oss models always reason (low/medium/high); "low" keeps chat replies fast.
LLM_REASONING_EFFORT=low
LLM_THINKING_TOKEN_HEADROOM=512

# Daily tip cron (server local time)
DAILY_TIP_CRON=0 8 * * *

# Base URL for Family Playbook links shared with caregivers (must be reachable from their phones).
# Empty: https://<NGROK_DOMAIN> if set, else http://localhost:<PORT>.
PUBLIC_BASE_URL=

# Password-reset emails (https://resend.com/api-keys). Empty: dev prints the code in the API log.
RESEND_API_KEY=
EMAIL_FROM=ParentPal <onboarding@resend.dev>

# Rate limits: "on" (default) or "off" for local load testing.
RATE_LIMITS=on
# Trust X-Forwarded-For for client IPs. Empty: on when NGROK_DOMAIN is set.
TRUST_PROXY=

# --- Mobile (Expo reads EXPO_PUBLIC_*) ---
EXPO_PUBLIC_API_URL=http://localhost:4000

# --- ngrok (npm run dev:tunnel) ---
# Free static domain from https://dashboard.ngrok.com/domains; then set
# EXPO_PUBLIC_API_URL=https://<NGROK_DOMAIN> in apps/mobile/.env.local.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
